{
  "name": "mcp-devkit",
  "version": "0.1.0",
  "description": "A zero-dependency testing & inspection toolkit for Model Context Protocol (MCP) servers: in-memory and stdio test clients, fluent tool-result assertions, input-schema validation, and an automated conformance checker. Library + CLI.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "modelcontextprotocol",
    "ai",
    "llm",
    "agents",
    "tools",
    "testing",
    "test",
    "harness",
    "assertions",
    "conformance",
    "inspector",
    "devtools",
    "cli"
  ],
  "license": "MIT",
  "author": "sriramadari",
  "homepage": "https://github.com/sriramadari/mcp-devkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sriramadari/mcp-devkit.git"
  },
  "bugs": {
    "url": "https://github.com/sriramadari/mcp-devkit/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "mcp-devkit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.10.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/node": "^20.14.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "zod": "^3.23.8"
  }
}
